{
  "expo": {
    "name": "SubFlow",
    "slug": "subflow",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icons/SubFlow-Logo.png",

    "scheme": "subflowapp",

    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.Kaif.subflow",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.Kaif.subflow",
      "icon": "./assets/icons/SubFlow-Logo.png",
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/SubFlow-Logo.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/SubFlow-Logo.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#EE7854",
          "dark": {
            "backgroundColor": "#EE7854"
          }
        }
      ],

      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./assets/fonts/PlusJakartaSans-Light.ttf"
          ]
        }
      ],

      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@clerk/expo",
      "expo-secure-store",
      "expo-localization"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc826afb-5ba5-43a6-b012-7e217a2e2889"
      }
    }
  }
}
